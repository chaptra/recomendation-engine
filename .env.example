# Database Configuration
RDS_DB_URL=postgresql://username:password@hostname:5432/database_name
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache Configuration
CACHE_DIR=./cache
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE_GB=5.0

# Model Configuration
MODEL_MAX_FEATURES=5000
MODEL_MIN_DF=3
MODEL_MAX_DF=0.7
MODEL_DESC_MAX_LENGTH=500
MODEL_SIM_THRESHOLD=0.1

# API Configuration
API_MAX_RECOMMENDATIONS=50
API_DEFAULT_RECOMMENDATIONS=10
API_RATE_LIMIT=100
API_TIMEOUT_SECONDS=30

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: For production deployments
# SECRET_KEY=your-secret-key-here
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com